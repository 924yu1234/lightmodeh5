    "clean:production": "rm -rf build && npm install --ignore-scripts && npm run build",
    "typecheck": "tsc",
    "lint:eslint": "eslint --ext .ts,.tsx,.js,.jsx src --ignore-pattern 'src/tradingView/**' --fix",
    "prettier": "prettier --check src",
    "prettier:fix": "prettier --write src",
    "test": "jest -i",
    "test:unit": "jest --config jest.config.test.js",
    "test:watch": "jest --config jest.config.test.js --watch",
    "test:coverage": "jest --config jest.config.test.js --coverage",
